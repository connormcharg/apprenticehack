# Copy to .env and fill in your key. Never commit .env.
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-paste-your-key-here
# Any OpenRouter model works; free ones end in :free (free list changes often —
# check https://openrouter.ai/models?max_price=0). Verified working 2026-10-03:
#   qwen/qwen3.8-27b:free
#   liquid/lfm-2.5-2.6b:free
#   google/gemma-4-31b-it:free
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
